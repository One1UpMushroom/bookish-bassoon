  (text "24 V INPUT AND PROTECTION"
    (at 20.32 20.32 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid "faedde64-d906-5c29-b322-1f1cfefed138")
  )
  (text "5 V FOR THE CONTROLLER: LMR33630 BUCK (BUCK//33630 CIRCUIT)"
    (at 134.62 20.32 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid "4879beaf-b70b-5f60-94c4-c76734175c19")
  )
  (text "CONTROLLER"
    (at 101.6 64.77 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid "39606e36-df50-5006-8531-cc9f166e41b9")
  )
  (text "J4 carries seven wires to the TFT (3V, MOSI, SCK, LITE, CS, DC, GND)"
    (at 101.6 71.12 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "5ca49367-18f4-5caf-98db-1b0c9b1dba9f")
  )
  (text "and one to the encoder board (INT). The encoder itself plugs into the"
    (at 101.6 74.168 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "062bc9ad-e000-5638-8ff3-5d1bb50fb4cd")
  )
  (text "QT Py's STEMMA QT socket. U1 pin numbers: 1-7 down the left side from"
    (at 101.6 77.216 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "7f09e773-8a9f-535b-bc85-942299b8f1eb")
  )
  (text "the USB socket, 8-14 back up the right side."
    (at 101.6 80.264 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "49282cc0-fdb3-56e8-abe8-eca69e84c191")
  )
  (text "STRIP SWITCHES  (five identical: gate resistor, pull-down, MOSFET, clamp diode)"
    (at 20.32 90.17 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid "456fea91-8159-50b2-b8cc-a94c5ad18880")
  )
  (text "TO THE STRIPS"
    (at 238.76 100.33 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid "43435440-e2f7-5b1b-a9f0-016bc86e3357")
  )
  (text "MOUNTING HOLES AND TEST PADS"
    (at 20.32 151.13 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid "e8fd4112-5646-5ff3-8862-c3736dd95882")
  )
  (text "Loads at 100 %:  red, green, blue about 0.13 A each;  warm, cool about 0.30 A each;  everything on about 1.0 A."
    (at 101.6 157.48 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "a989d7dd-6367-56cb-b34d-4e16bdc695c5")
  )
  (text "The gates are driven straight from the 3.3 V pins. At these currents an IRLB8721 is fully on;"
    (at 101.6 160.528 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
